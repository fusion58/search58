# Search58 — API de geocodificación inversa
# Copia como .env en el server, llena los valores reales y guarda con chmod 600

# Bind de Tailscale (IP del server QA)
SEARCH58_BIND=<ip-tailscale>
SEARCH58_PORT=7070

# Geocodificador (variables específicas según el stack que se defina en issue #1)
# NOMINATIM_PBF_URL=https://download.geofabrik.de/south-america/venezuela-latest.osm.pbf
